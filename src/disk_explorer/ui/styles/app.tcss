Screen {
    background: $surface;
}

#main {
    height: 1fr;
    min-height: 5;
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

#explorer-pane {
    height: 1fr;
    min-height: 5;
}

#pathbar {
    height: 3;
    min-height: 3;
    margin-bottom: 1;
}

#path-input {
    width: 1fr;
}

#pathbar Button {
    min-width: 7;
    margin-left: 1;
}

#explorer-layout {
    height: 1fr;
    min-height: 4;
}

#listing-panel {
    width: 1fr;
    min-width: 30;
}

#listing-summary {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 1;
    color: $text-muted;
}

#file-table {
    height: 1fr;
    min-height: 3;
}

#details-panel {
    width: 34;
    min-width: 24;
    height: 1fr;
    margin-left: 1;
    padding: 1;
    border: round $primary-darken-2;
    overflow-y: auto;
}

#details {
    width: 100%;
    height: auto;
}

.workspace-copy {
    width: 100%;
    height: 1fr;
    content-align: left top;
    padding: 1 2;
    border: round $primary-darken-2;
    color: $text;
}

#status {
    height: auto;
    min-height: 1;
    max-height: 2;
    padding: 0 1;
    color: $text-muted;
    background: $boost;
}

#status.error {
    color: $error;
    text-style: bold;
}

#analyzer-visual-scroll {
    height: 1fr;
    min-height: 5;
}

#analyzer-visual-text {
    width: 100%;
    height: auto;
    padding: 0 1;
}
